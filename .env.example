
# Application
APP_NAME=FraudGraph
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# Neo4j Community 5
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_local_only
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=20
NEO4J_QUERY_TIMEOUT_SECONDS=5

# PostgreSQL 17
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fraudgraph
POSTGRES_USER=fraudgraph
POSTGRES_PASSWORD=change_me_local_only
DATABASE_URL=postgresql+psycopg://fraudgraph:change_me_local_only@localhost:5432/fraudgraph

# Redis 7
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
FEATURE_CACHE_TTL_SECONDS=300